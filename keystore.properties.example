# Plantilla para firmar la versión release EN TU ORDENADOR.
# 1. Copia este archivo como `keystore.properties` (está en .gitignore, NUNCA se sube).
# 2. Rellena tus datos reales.
# 3. ./gradlew :app:assembleRelease
#
# En GitHub Actions no se usa este archivo: los mismos valores vienen de los secrets
# MT_KEYSTORE_BASE64, MT_KEYSTORE_PASSWORD, MT_KEY_ALIAS y MT_KEY_PASSWORD.

# Ruta al keystore, relativa a la raíz del proyecto o absoluta. Guárdalo FUERA del proyecto.
MT_KEYSTORE_PATH=C:/Users/TU_USUARIO/claves/mi-tacografo-release.jks
MT_KEYSTORE_PASSWORD=
MT_KEY_ALIAS=mi-tacografo
MT_KEY_PASSWORD=
